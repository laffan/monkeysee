{
  "name": "monkeysee",
  "version": "0.1.0",
  "description": "Record short, scripted feature demos of web and Tauri apps, with visible keyboard shortcuts and themed sample content.",
  "type": "module",
  "private": true,
  "bin": {
    "monkeysee": "agent-mode/src/cli.mjs"
  },
  "scripts": {
    "record": "node agent-mode/src/cli.mjs record",
    "plan": "node agent-mode/src/cli.mjs plan",
    "inspect": "node agent-mode/src/cli.mjs inspect",
    "check": "node agent-mode/src/cli.mjs check",
    "content:fetch": "node agent-mode/src/cli.mjs fetch-content"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "playwright": "1.49.1",
    "yaml": "2.6.1"
  },
  "exports": {
    ".": "./agent-mode/src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "agent-mode/src",
    "agent-mode/content",
    "agent-mode/fixtures",
    "agent-mode/docs",
    "agent-mode/README.md",
    "README.md"
  ]
}
